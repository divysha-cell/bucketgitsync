            "PropertyName": "Location ID",
            "Type": "String"
        },
        {
            "Id": 0,
            "Mandatory": true,
            "DefaultValue": "gemini-2.0-flash-lite",
            "Description": "The name of the default model to use in the integration.",
            "DisplayName": "Default Model",
